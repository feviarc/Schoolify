rules_version = '2';

// Estado actual:
//   - Escrituras acotadas por rol. Antes eran `allow write: if request.auth != null`,
//     asi que cualquiera que se registrara podia reescribir la base entera, incluido
//     su propio `rol` (auto-ascenso a administrador) y el borrado de cuentas.
//   - `escuelas` es solo del administrador porque el documento contiene el `pin`,
//     que es la credencial de acceso al portal.
//   - Las lecturas estan acotadas por escuela o por dueño: nadie lee datos de otra
//     escuela.
//   - Todo lo que no sea registrarse exige CORREO VERIFICADO. Sin esto, una cuenta
//     recien creada (que la interfaz bloquea, pero la API no) podia leer los datos
//     de su escuela. El unico permiso que se conserva sin verificar es el propio
//     autoregistro, porque en ese momento el usuario todavia no puede verificar.
//     OJO: el token del usuario tarda hasta una hora en reflejar la verificacion,
//     asi que quien acabe de verificar debe cerrar sesion y volver a entrar.
//
// Ojo: las reglas no son filtros. Cada consulta del cliente tiene que ser compatible
// (filtrar por `cct`, por `tid` o por el uid del dueño); si no, Firestore la rechaza
// entera. Las consultas reales de la app estan cubiertas en tools/rules-tests.mjs.
//
// Antes de desplegar:
//   1) tiene que existir al menos un usuario con `rol: 'administrador'` y con el
//      correo VERIFICADO; si no, se siembra a mano en la consola (el Admin SDK no
//      pasa por estas reglas);
//   2) el cliente ya no debe intentar registrarse como administrador
//      (el rol se elige en auth.page.ts entre maestro y tutor).
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // El candado normal: hay sesion y el correo esta verificado.
    function hasVerifiedEmail() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    // Perfil del usuario que hace la peticion. Si no existe, el acceso al campo
    // produce error y la condicion se evalua como falsa (se deniega).
    function profile() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return hasVerifiedEmail() && profile().rol == 'administrador';
    }

    function isTeacher() {
      return hasVerifiedEmail() && profile().rol == 'maestro';
    }

    function isAdminOrTeacher() {
      return isAdmin() || isTeacher();
    }

    function isOwnProfile(uid) {
      return hasVerifiedEmail() && request.auth.uid == uid;
    }

    // La escuela del usuario que hace la peticion.
    function ownCct() {
      return profile().cct;
    }

    // Compañeros de escuela: el tutor ve a los maestros de la suya, y el maestro
    // las notificaciones de los tutores de la suya.
    function sameSchoolAs(uid) {
      return hasVerifiedEmail()
        && get(/databases/$(database)/documents/usuarios/$(uid)).data.cct == ownCct();
    }

    // Claves que cambiaron respecto al documento actual.
    function anyKeyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    function onlyKeysChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ==================== usuarios ====================

    match /usuarios/{uid} {
      // El dueño, el administrador y los compañeros de la misma escuela
      // (la agenda del tutor consulta `where('cct', '==', ...)`).
      allow read: if isOwnProfile(uid)
        || isAdmin()
        || (hasVerifiedEmail() && resource.data.cct == ownCct());

      // Autoregistro. Es el unico permiso que NO exige correo verificado: en este
      // momento el usuario acaba de crearse y todavia no puede haber verificado.
      allow create: if isAuthenticated()
        && request.auth.uid == uid
        && request.resource.data.rol in ['maestro', 'tutor'];

      // El dueño mantiene su perfil, su escuela y sus tokens FCM, pero NO puede
      // tocarse el rol (aqui se corta la escalada de privilegios).
      allow update: if isAdmin()
        || (isOwnProfile(uid) && !anyKeyChanged(['rol', 'uid', 'email']));

      // Borrar cuentas es cosa del administrador (o de la funcion deleteTeacher).
      allow delete: if isAdmin();
    }

    // Avisos dentro de cada usuario: los escribe el maestro que los genera y los
    // gestiona el administrador. Los lee el tutor dueño y el maestro de su escuela
    // (el historial que abre desde la lista de alumnos).
    match /usuarios/{uid}/notificaciones/{notificationId} {
      allow read: if isOwnProfile(uid)
        || isAdmin()
        || (isTeacher() && sameSchoolAs(uid));

      allow create: if isAdminOrTeacher();

      allow update, delete: if isAdmin();
    }

    // ==================== escuelas ====================

    // Solo el administrador: el documento contiene el `pin`, que es la credencial
    // de acceso al portal. El portal valida CCT + PIN con la funcion
    // `validateSchoolAccess` (que es publica a proposito: el usuario todavia no
    // tiene sesion), y maestro/tutor obtienen su escuela con `getMySchool`.
    match /escuelas/{schoolId} {
      allow read: if isAdmin();

      allow write: if isAdmin();
    }

    // ==================== alumnos ====================

    match /alumnos/{studentId} {
      // Cualquier miembro de la escuela (maestro o tutor) lee los alumnos de SU
      // escuela con `where('cct', '==', ...)`: el tutor necesita ver a los alumnos
      // sin tutor para reclamar al suyo. El tutor conserva ademas la rama por
      // `tid`, que lo cubre aunque su perfil no tenga `cct` guardado.
      allow read: if isAdmin()
        || (hasVerifiedEmail() && resource.data.cct == ownCct())
        || (hasVerifiedEmail() && resource.data.tid == request.auth.uid);

      allow create, delete: if isAdminOrTeacher();

      // El maestro (y el administrador) editan todo. El tutor solo puede
      // reclamar al alumno para si mismo: `tid` debe ser su propio uid, y el
      // alumno no puede estar ya reclamado por otro tutor.
      allow update: if isAdminOrTeacher()
        || (hasVerifiedEmail()
            && request.resource.data.tid == request.auth.uid
            && resource.data.get('tid', '') in ['', request.auth.uid]
            && onlyKeysChanged(['tid', 'nombreTutor', 'updatedAt']));
    }

    // ==================== grupos y materias ====================

    // Catalogos generales: los lee el personal de la escuela para armar los avisos.
    match /grupos/{groupId} {
      allow read: if isAdminOrTeacher();

      allow write: if isAdmin();
    }

    match /materias/{subjectId} {
      allow read: if isAdminOrTeacher();

      allow write: if isAdmin();
    }

    match /grupos_de_alumnos/{gid} {
      // El maestro, los de su escuela (`where('cct', '==', ...)`).
      allow read: if isAdmin() || (isTeacher() && resource.data.cct == ownCct());

      allow write: if isAdminOrTeacher();
    }
  }
}
