rules_version = '2';

// Estado actual:
//   - Escrituras acotadas por rol. Antes eran `allow write: if request.auth != null`,
//     asi que cualquiera que se registrara podia reescribir la base entera, incluido
//     su propio `rol` (auto-ascenso a administrador) y el borrado de cuentas.
//   - `escuelas` es solo del administrador porque el documento contiene el `pin`,
//     que es la credencial de acceso al portal.
//   - Las lecturas marcadas como "Pendiente para la 1B" siguen abiertas: acotarlas
//     por escuela es el siguiente paso.
//
// Antes de desplegar:
//   1) tiene que existir al menos un usuario con `rol: 'administrador'`; si no,
//      se siembra a mano en la consola (el Admin SDK no pasa por estas reglas);
//   2) el cliente ya no debe intentar registrarse como administrador
//      (el rol se elige en auth.page.ts entre maestro y tutor).
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Perfil del usuario que hace la peticion. Si no existe, el acceso al campo
    // produce error y la condicion se evalua como falsa (se deniega).
    function profile() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && profile().rol == 'administrador';
    }

    function isTeacher() {
      return isAuthenticated() && profile().rol == 'maestro';
    }

    function isAdminOrTeacher() {
      return isAdmin() || isTeacher();
    }

    function isOwnProfile(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Claves que cambiaron respecto al documento actual.
    function anyKeyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    function onlyKeysChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ==================== usuarios ====================

    match /usuarios/{uid} {
      // Pendiente para la 1B: hoy cualquier usuario autenticado lee cualquier perfil.
      allow read: if true;

      // Autoregistro: solo maestro o tutor. El primer administrador se siembra
      // desde la consola, nunca desde el cliente.
      allow create: if isOwnProfile(uid)
        && request.resource.data.rol in ['maestro', 'tutor'];

      // El dueño mantiene su perfil, su escuela y sus tokens FCM, pero NO puede
      // tocarse el rol (aqui se corta la escalada de privilegios).
      allow update: if isAdmin()
        || (isOwnProfile(uid) && !anyKeyChanged(['rol', 'uid', 'email']));

      // Borrar cuentas es cosa del administrador (o de la funcion deleteTeacher).
      allow delete: if isAdmin();
    }

    // Avisos dentro de cada usuario: los escribe el maestro que los genera, los
    // gestiona el administrador. El tutor solo los lee.
    match /usuarios/{uid}/notificaciones/{notificationId} {
      // Pendiente para la 1B: deberia leerlas solo su dueño (y el administrador).
      allow read: if true;

      allow create: if isAdminOrTeacher();

      allow update, delete: if isAdmin();
    }

    // ==================== escuelas ====================

    // Solo el administrador: el documento contiene el `pin`, que es la credencial
    // de acceso al portal. El portal valida CCT + PIN con la funcion
    // `validateSchoolAccess`, y maestro/tutor obtienen su escuela con `getMySchool`;
    // ambas usan el Admin SDK, que no pasa por estas reglas.
    match /escuelas/{schoolId} {
      allow read: if isAdmin();

      allow write: if isAdmin();
    }

    // ==================== alumnos ====================

    match /alumnos/{studentId} {
      // Pendiente para la 1B: acotar por escuela (`resource.data.cct`).
      allow read: if true;

      allow create, delete: if isAdminOrTeacher();

      // El maestro (y el administrador) editan todo. El tutor solo puede
      // reclamar al alumno para si mismo: `tid` debe ser su propio uid, y el
      // alumno no puede estar ya reclamado por otro tutor.
      allow update: if isAdminOrTeacher()
        || (isAuthenticated()
            && request.resource.data.tid == request.auth.uid
            && resource.data.get('tid', '') in ['', request.auth.uid]
            && onlyKeysChanged(['tid', 'nombreTutor', 'updatedAt']));
    }

    // ==================== grupos y materias ====================

    match /grupos/{groupId} {
      // Pendiente para la 1B.
      allow read: if true;

      allow write: if isAdmin();
    }

    match /materias/{subjectId} {
      // Pendiente para la 1B.
      allow read: if true;

      allow write: if isAdmin();
    }

    match /grupos_de_alumnos/{gid} {
      // Pendiente para la 1B: acotar por escuela (`resource.data.cct`).
      allow read: if true;

      allow write: if isAdminOrTeacher();
    }

    // ==================== lecturas ====================

    // No hay un bloque `match /{document=**}` que abra la lectura de todo: cada
    // coleccion concede la lectura que necesita, y lo que no se concede queda
    // denegado.
  }
}
