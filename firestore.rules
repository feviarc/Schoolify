rules_version = '2';

// Fase 2: se restringen las ESCRITURAS.
// Antes: `allow write: if request.auth != null`, es decir cualquier persona que se
// registrara podia reescribir toda la base, incluido su propio `rol` (auto-ascenso
// a administrador) y el borrado de cuentas.
//
// Las LECTURAS siguen como estaban (publicas) y se cierran en la Fase 1.
//
// Antes de desplegar estas reglas:
//   1) tiene que existir al menos un usuario con `rol: 'administrador'`; si no,
//      se siembra a mano en la consola (el Admin SDK no pasa por estas reglas);
//   2) el cliente ya no debe intentar registrarse como administrador
//      (rama `isFirstUser` de auth.page.ts).
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    // Perfil del usuario que hace la peticion. Si no existe, el acceso al campo
    // produce error y la condicion se evalua como falsa (se deniega).
    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function esAdmin() {
      return autenticado() && perfil().rol == 'administrador';
    }

    function esMaestro() {
      return autenticado() && perfil().rol == 'maestro';
    }

    function esAdminOMaestro() {
      return esAdmin() || esMaestro();
    }

    function esMiPerfil(uid) {
      return autenticado() && request.auth.uid == uid;
    }

    // Claves que cambiaron respecto al documento actual.
    function cambioAlguno(claves) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(claves);
    }

    function soloCambia(claves) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(claves);
    }

    // ==================== usuarios ====================

    match /usuarios/{uid} {
      // Autoregistro: solo maestro o tutor. El primer administrador se siembra
      // desde la consola, nunca desde el cliente.
      allow create: if esMiPerfil(uid)
        && request.resource.data.rol in ['maestro', 'tutor'];

      // El dueño mantiene su perfil, su escuela y sus tokens FCM, pero NO puede
      // tocarse el rol (aqui se corta la escalada de privilegios).
      allow update: if esAdmin()
        || (esMiPerfil(uid) && !cambioAlguno(['rol', 'uid', 'email']));

      // Borrar cuentas es cosa del administrador (o de la funcion deleteTeacher).
      allow delete: if esAdmin();
    }

    // Avisos dentro de cada usuario: los escribe el maestro que los genera, los
    // gestiona el administrador. El tutor solo los lee.
    match /usuarios/{uid}/notificaciones/{notificacionId} {
      allow create: if esAdminOMaestro();

      allow update, delete: if esAdmin();
    }

    // ==================== escuelas ====================

    // La gestion de escuelas vive en el panel de administrador.
    // OJO: la lectura seguira siendo publica hasta la Fase 1 (aqui esta el `pin`).
    match /escuelas/{escuelaId} {
      allow write: if esAdmin();
    }

    // ==================== alumnos ====================

    match /alumnos/{alumnoId} {
      allow create, delete: if esAdminOMaestro();

      // El maestro (y el administrador) editan todo. El tutor solo puede
      // reclamar al alumno para si mismo: `tid` debe ser su propio uid, y el
      // alumno no puede estar ya reclamado por otro tutor.
      allow update: if esAdminOMaestro()
        || (autenticado()
            && request.resource.data.tid == request.auth.uid
            && resource.data.get('tid', '') in ['', request.auth.uid]
            && soloCambia(['tid', 'nombreTutor', 'updatedAt']));
    }

    // ==================== grupos y materias ====================

    match /grupos/{grupoId} {
      allow write: if esAdmin();
    }

    match /materias/{materiaId} {
      allow write: if esAdmin();
    }

    match /grupos_de_alumnos/{gid} {
      allow write: if esAdminOMaestro();
    }

    // ==================== lecturas ====================

    // Sin cambios respecto a las reglas anteriores: todo el mundo puede leer.
    // Este bloque es lo que la Fase 1 tiene que eliminar, junto con la mudanza
    // del `pin` a un documento privado.
    match /{document=**} {
      allow read: if true;
    }
  }
}
